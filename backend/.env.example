# Server Configuration
PROJECT_NAME="OutbreakIQ Backend"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (JSON array of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Teammate Database Connection (Leave empty or set to sqlite for standalone testing)
# Example PostgreSQL: postgresql+psycopg://user:password@localhost:5432/outbreakiq
DATABASE_URL="sqlite:///./outbreakiq.db"

# Security & Authentication
JWT_SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Privacy Preservation Settings
# Minimum cell count threshold for aggregate health signals (records below this are suppressed)
PRIVACY_MIN_COUNT_THRESHOLD=5

# Analytical Engine Parameters
BASELINE_HISTORICAL_DAYS=28
ANOMALY_ZSCORE_THRESHOLD=2.5
DUPLICATE_ALERT_COOLDOWN_HOURS=24
