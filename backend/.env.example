# Server Configuration
PROJECT_NAME="OutbreakIQ Backend"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (JSON array of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173","https://koushik-2006.github.io"]

# PostgreSQL Database Connection (aurora_health)
# Production / Docker: postgresql+psycopg://postgres:postgrespassword@localhost:5432/aurora_health
# Local Dev Default: sqlite:///./aurora_health.db
DATABASE_URL="postgresql+psycopg://postgres:postgrespassword@localhost:5432/aurora_health"

# Security & Authentication
JWT_SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Privacy Preservation Settings
# Minimum cell count threshold for aggregate health signals (records below this are suppressed)
PRIVACY_MIN_COUNT_THRESHOLD=5

# Analytical Engine Parameters
BASELINE_HISTORICAL_DAYS=28
ANOMALY_ZSCORE_THRESHOLD=2.5
DUPLICATE_ALERT_COOLDOWN_HOURS=24
